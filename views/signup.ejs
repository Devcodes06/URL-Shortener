<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup</title>
</head>
<style>
    body {
        background-color: rgb(84, 255, 5);
        font-family: 'Times New Roman', Times, serif;
        margin: 20px;
    }
</style>
<body><h1>Signup</h1>
    <form method="POST" action="/user">
        <label>Name:</label>
        <input type="text" name="name" placeholder="Enter Beautiful Name"required><br><br>
        <label>Email:</label>
        <input type="text" name="email" placeholder="Enter Embrassing Email" required><br><br>
        <label>Password:</label>
        <input type="text" name="password" placeholder="Enter Password" required>
        
        <button type="submit">SignUp</button>
    </form>
    
</body>
</html>